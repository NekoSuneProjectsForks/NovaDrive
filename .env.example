FLASK_APP=novadrive.app:create_app
FLASK_ENV=development
SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/novadrive.db
# Primary/canonical public base URL. Used for emails and as the fallback for
# generated links. Leave blank to use Flask/request-derived URLs.
# Examples without scheme:
# - drive.example.com -> https://drive.example.com
# - 192.168.1.107:5000 -> http://192.168.1.107:5000
# - localhost:5000 -> http://localhost:5000
APP_EXTERNAL_URL=
# Extra hosts that may also serve NovaDrive (comma or space separated). When a
# request arrives on one of these hosts, ShareX/share/WebDAV links are built
# from that host, so the public domain AND a LAN address both return working
# URLs. Same scheme inference as APP_EXTERNAL_URL.
# Example: APP_EXTERNAL_URLS=192.168.1.107:5666, http://novadrive.local:5666
APP_EXTERNAL_URLS=

# Absolute upload ceiling in bytes. 5368709120 = 5 GiB, 1073741824 = 1 GiB,
# 536870912 = 512 MiB. If you raise this above 1 GiB, also raise waitress's
# --max-request-body-size in your server command (see Dockerfile/compose),
# otherwise large uploads are dropped mid-transfer.
MAX_UPLOAD_SIZE_BYTES=5368709120
# Cloudflare upload compatibility:
# Turn this ON when NovaDrive is reached through Cloudflare Tunnel or a normal proxied
# Cloudflare hostname (orange cloud). NovaDrive will clamp uploads before Cloudflare
# returns 413 Payload Too Large at the edge.
# Turn this OFF when users connect directly to your server, over LAN/local IP, or through
# a DNS-only / grey-cloud Cloudflare record where Cloudflare is not proxying the upload.
# Effective upload limit becomes:
# min(MAX_UPLOAD_SIZE_BYTES, built-in safe Cloudflare plan cap)
CLOUDFLARE_TUNNEL_COMPAT=false
# Cloudflare plan to match when CLOUDFLARE_TUNNEL_COMPAT=true.
# Allowed values: free, pro, business, enterprise
# NovaDrive uses built-in conservative request-size caps so multipart uploads stay under
# Cloudflare's edge limit without needing another setting:
# - free: 99,000,000 bytes
# - pro: 99,000,000 bytes
# - business: 199,000,000 bytes
# - enterprise: 499,000,000 bytes
# Examples:
# - Using Cloudflare Tunnel on the free plan: CLOUDFLARE_TUNNEL_PLAN=free
# - Using a proxied domain on Business: CLOUDFLARE_TUNNEL_PLAN=business
# - Not using Cloudflare proxy/tunnel: leave CLOUDFLARE_TUNNEL_COMPAT=false and this value can stay as-is
CLOUDFLARE_TUNNEL_PLAN=free
SPOOL_MAX_MEMORY_BYTES=8388608
TEXT_PREVIEW_MAX_BYTES=1048576

# Background workers (in-process). Disable for one-off CLI invocations.
BACKGROUND_WORKERS_ENABLED=true
# One-time startup pass that merges legacy multi-chunk S3 objects into single
# objects. Idempotent; runs only when STORAGE_BACKEND=s3.
STORAGE_CONSOLIDATE_ON_STARTUP=true

# Remote download ("Add by URL"): fetch files server-side into the drive.
REMOTE_DOWNLOAD_ENABLED=true
REMOTE_DOWNLOAD_WORKERS=2
REMOTE_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=15
REMOTE_DOWNLOAD_READ_TIMEOUT_SECONDS=120
# Allow downloads from private/loopback addresses (SSRF risk). Keep false.
REMOTE_DOWNLOAD_ALLOW_PRIVATE_HOSTS=false
# Default torrent/magnet permission for non-admin users (per-user overridable in
# the admin profile page). Admins always have access. Needs the aria2 binary.
REMOTE_DOWNLOAD_ALLOW_TORRENTS=true

# URL shortener. Native /u/<code> links are always on. is.gd + TinyURL are free
# (no key); Bitly is offered when its token is set.
SHORTENER_PUBLIC_ENABLED=true            # offer is.gd + TinyURL (no API key)
SHORTENER_BITLY_TOKEN=                    # Bitly API token enables the Bitly provider
#
# "Support the community" ad shorteners: ONE list of {name, url, key}. The URL is
# a template where {url} (the long link) and {key} (your token) are substituted.
# Every entry you add appears in the dropdown for users to choose. Income is the
# instance owner's. Response may be JSON (shortenedUrl / short / url, or a custom
# "result" field) or a plain-text short URL. Keep it on ONE line.
# SHORTENER_PROVIDERS=[{"name":"GPLinks","url":"https://gplinks.co/api?api={key}&url={url}","key":"TOKEN"},{"name":"ShrinkEarn","url":"https://shrinkearn.com/api?api={key}&url={url}","key":"TOKEN"},{"name":"Ouo.io","url":"https://ouo.io/api/{key}?s={url}","key":"TOKEN"}]
SHORTENER_PROVIDERS=

# Third-party temp upload ("Send to a temp host"). Copies a stored file to an
# external host in the background and returns a link. Configure hosts as a JSON
# list of {name, method (PUT|POST), url (template with {filename}), field
# (multipart field for POST), result ("text" | "json:a.b" | "regex:PATTERN"),
# max_size (bytes, 0=unlimited), headers (object)}. Keep it on ONE line.
EXTERNAL_UPLOAD_ENABLED=true
EXTERNAL_UPLOAD_WORKERS=1
EXTERNAL_UPLOAD_TIMEOUT_SECONDS=1800
# Examples (verify each host's current API/limits before relying on them):
#   GoFile (large/free): {"name":"GoFile","type":"gofile","max_size":0}   <-- best for multi-GB; auto-picks a server
#   transfer.sh (PUT):   {"name":"transfer.sh","method":"PUT","url":"https://transfer.sh/{filename}","result":"text","max_size":0,"headers":{"Max-Days":"5"}}
#   0x0.st (POST):       {"name":"0x0","method":"POST","url":"https://0x0.st","field":"file","result":"text","max_size":536870912}   <-- 512 MB cap
# NOTE: 0x0 rejects files over 512 MB, so large files won't list it. Use GoFile
# (type:gofile) or a self-hosted transfer.sh with max_size:0 for multi-GB files.
# EXTERNAL_UPLOAD_PROVIDERS=[{"name":"GoFile","type":"gofile","max_size":0},{"name":"0x0","method":"POST","url":"https://0x0.st","field":"file","result":"text","max_size":536870912}]
EXTERNAL_UPLOAD_PROVIDERS=
DEFAULT_USER_STORAGE_QUOTA_BYTES=10737418240
DEFAULT_ADMIN_STORAGE_QUOTA_BYTES=0
SESSION_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME_HOURS=24
# Turn this OFF to disable the public /auth/register page and make the site login-only.
# Admins can still create accounts from the admin dashboard or the CLI.
ALLOW_PUBLIC_REGISTRATION=true
# Label shown inside authenticator apps when users enable TOTP 2FA.
TWO_FACTOR_ISSUER_NAME=NovaDrive

STORAGE_BACKEND=discord
ALLOW_PUBLIC_SHARING=true
SOFT_DELETE_ENABLED=true
WEBDAV_ENABLED=true
WEBDAV_REALM=NovaDrive WebDAV
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_BUCKET_NAME=
# Object key prefix under the bucket. Objects are stored as
#   <prefix>/files/<username>/<folder path>/<filename>
# Leave EMPTY if your bucket is already named "novadrive" to avoid a doubled
# novadrive/novadrive/... path.
S3_PREFIX=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_MAX_AGE_SECONDS=86400
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60
# Password recovery links sent from the login page or admin user details screen.
# Requires SMTP to be configured below.
PASSWORD_RESET_MAX_AGE_SECONDS=3600
PASSWORD_RESET_RESEND_INTERVAL_SECONDS=60

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NovaDrive
SMTP_TIMEOUT_SECONDS=20

DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=123456789012345678
DISCORD_STORAGE_CHANNEL_IDS=123456789012345678,234567890123456789
DISCORD_ATTACHMENT_LIMIT_BYTES=8000000
DISCORD_CHUNK_MARGIN_BYTES=262144
DISCORD_CHUNK_SIZE_BYTES=7737856
DISCORD_BOT_BRIDGE_URL=http://127.0.0.1:5051
DISCORD_BOT_BRIDGE_SHARED_SECRET=replace-this-bridge-secret
DISCORD_BOT_BRIDGE_CONNECT_TIMEOUT_SECONDS=2
DISCORD_BOT_BRIDGE_TIMEOUT_SECONDS=60
DISCORD_UPLOAD_RETRY_COUNT=3
DISCORD_FETCH_RETRY_COUNT=0

SHARE_TOKEN_BYTES=24
LOG_LEVEL=INFO
